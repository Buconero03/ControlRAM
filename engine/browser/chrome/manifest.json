{
  "manifest_version": 3,
  "name": "AME — Schede ricaricabili",
  "version": "0.5.0",
  "minimum_chrome_version": "121",
  "description": "Scaricamento manuale di schede dalla memoria, tramite il tuo hub Windows AME.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
